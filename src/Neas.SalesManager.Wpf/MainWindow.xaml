<Window x:Class="Neas.SalesManager.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEAS Energy - District &amp; Sales Management System" Height="720" Width="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" Padding="15" CornerRadius="6" Margin="0,0,0,15">
            <DockPanel>
                <Button Content="Refresh Data" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Padding="12,6" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <TextBlock Text="Neas Sales Management Console" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- District Navigation & Management Panel (Left Column) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- District Selection List (Top) -->
                <GroupBox Grid.Row="0" Header="Districts" FontWeight="Bold" Padding="5" Margin="0,0,0,10">
                    <ListBox ItemsSource="{Binding Districts}" SelectedItem="{Binding SelectedDistrict}"
                             DisplayMemberPath="Name" FontSize="14" Margin="5"/>
                </GroupBox>

                <!-- Create New District Form (Below List) -->
                <GroupBox Grid.Row="1" Header="Create New District" FontWeight="Bold" Padding="8">
                    <StackPanel>
                        <TextBlock Text="District Name:" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewDistrictName, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,8"/>

                        <TextBlock Text="Initial Primary Salesperson:" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableSalespersons}" 
                                  SelectedItem="{Binding SelectedPrimaryForNewDistrict}"
                                  DisplayMemberPath="FullNameWithId" 
                                  Margin="0,0,0,10"/>

                        <Button Content="Create District" Command="{Binding CreateDistrictCommand}" 
                                Padding="8,5" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <!-- District Details Panel (Right Column) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <!-- Salespersons List -->
                <GroupBox Grid.Row="0" Header="Assigned Salespersons" FontWeight="Bold" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="Remove Selected Salesperson" Command="{Binding RemoveSalespersonCommand}" 
                                Margin="5" Padding="8,4" Background="#EF4444" Foreground="White" HorizontalAlignment="Right"/>
                        <DataGrid ItemsSource="{Binding Salespersons}" SelectedItem="{Binding SelectedSalesperson}" AutoGenerateColumns="False" IsReadOnly="True" Margin="5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding SalespersonId}" Width="50"/>
                                <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*"/>
                                <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>
                                <DataGridCheckBoxColumn Header="Is Primary" Binding="{Binding IsPrimary}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>

                <!-- Assign Form with Name Dropdown -->
                <GroupBox Grid.Row="1" Header="Assign / Update Salesperson" FontWeight="Bold" Margin="0,0,0,10" Padding="10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Select Salesperson:" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <ComboBox ItemsSource="{Binding AvailableSalespersons}" 
                                  SelectedItem="{Binding SelectedSalespersonToAssign}"
                                  DisplayMemberPath="FullNameWithId" 
                                  Width="220" Padding="6,4" VerticalAlignment="Center" Margin="0,0,15,0"/>

                        <CheckBox Content="Set as Primary Salesperson" IsChecked="{Binding IsPrimaryAssign}" VerticalAlignment="Center" Margin="0,0,15,0"/>

                        <Button Content="Assign Salesperson" Command="{Binding AssignSalespersonCommand}" Padding="12,6" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Stores List -->
                <GroupBox Grid.Row="2" Header="District Stores" FontWeight="Bold">
                    <DataGrid ItemsSource="{Binding Stores}" AutoGenerateColumns="False" IsReadOnly="True" Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Store ID" Binding="{Binding StoreId}" Width="70"/>
                            <DataGridTextColumn Header="Store Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem TextBlock.Foreground="#475569">
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>